{
  "name": "konekton",
  "displayName": "Konekton",
  "description": "A Miro-like board for VS Code: sticky notes, rectangles, file references and connection lines, stored as .canvas files.",
  "version": "0.1.0",
  "publisher": "TODO-publisher",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "TODO-repository-url"
  },
  "engines": {
    "vscode": "^1.123.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "icon": "media/icon.png",
  "main": "./dist/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "konekton.board",
        "displayName": "Konekton Board",
        "selector": [
          {
            "filenamePattern": "*.canvas"
          }
        ],
        "priority": "default"
      }
    ],
    "configuration": {
      "title": "Konekton",
      "properties": {
        "konekton.grid.enabled": {
          "type": "boolean",
          "default": false,
          "scope": "application",
          "description": "Show the board grid and snap objects to it."
        }
      }
    }
  },
  "scripts": {
    "build": "npm run typecheck && node esbuild.mjs && vite build --config webview/vite.config.mts",
    "build:extension": "node esbuild.mjs",
    "build:webview": "vite build --config webview/vite.config.mts",
    "watch": "concurrently -k \"node esbuild.mjs --watch\" \"vite build --watch --config webview/vite.config.mts\"",
    "compile-tests": "tsc -p test/integration/tsconfig.json",
    "test:unit": "vitest run",
    "test:integration": "npm run build && npm run compile-tests && vscode-test",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p webview/tsconfig.json --noEmit",
    "package": "vsce package --no-dependencies",
    "vscode:prepublish": "npm run build"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/vscode": "1.120.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "mocha": "^12.0.3",
    "ovsx": "^1.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.46-24",
    "@xyflow/react": "^12.12.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.15"
  },
  "overrides": {
    "serialize-javascript": "^7.0.5",
    "diff": "^8.0.3",
    "@vscode/test-cli": {
      "mocha": {
        "glob": "^13.0.6"
      }
    }
  }
}
